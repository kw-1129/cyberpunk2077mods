public abstract class ProjectCapricornVoiceDurations {
  public static func Seconds(group: Int32, choice: Int32) -> Float {
    if group == 0 && choice == 0 { return 4.833; };
    if group == 0 && choice == 1 { return 4.754; };
    if group == 0 && choice == 2 { return 4.206; };
    if group == 0 && choice == 3 { return 5.329; };
    if group == 0 && choice == 4 { return 5.486; };
    if group == 1 && choice == 0 { return 5.486; };
    if group == 1 && choice == 1 { return 5.068; };
    if group == 1 && choice == 2 { return 3.971; };
    if group == 1 && choice == 3 { return 5.407; };
    if group == 2 && choice == 0 { return 5.407; };
    if group == 2 && choice == 1 { return 5.068; };
    if group == 2 && choice == 2 { return 4.833; };
    if group == 2 && choice == 3 { return 4.519; };
    if group == 3 && choice == 0 { return 5.146; };
    if group == 3 && choice == 1 { return 6.034; };
    if group == 3 && choice == 2 { return 4.911; };
    if group == 3 && choice == 3 { return 6.687; };
    if group == 4 && choice == 0 { return 5.146; };
    if group == 4 && choice == 1 { return 6.113; };
    if group == 4 && choice == 2 { return 4.049; };
    if group == 4 && choice == 3 { return 5.642; };
    if group == 5 && choice == 0 { return 6.191; };
    if group == 5 && choice == 1 { return 4.989; };
    if group == 5 && choice == 2 { return 5.407; };
    if group == 5 && choice == 3 { return 6.426; };
    return 0.0;
  }
}
